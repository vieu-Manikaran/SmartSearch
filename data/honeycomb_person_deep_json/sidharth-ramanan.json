          "title": "React Native Awesome Chat",
          "subtitle": "Jul 2020 - Present",
          "subComponenets": [
            {
              "description": [
                {
                  "type": "textComponent",
                  "text": "React Native Awesome Chat is a customizable, easy-to-integrate chat UI library for React Native \nmobile applications. It offers useful features for creating chat interfaces, such as image backgrounds, tapping to resend a message, auto-scroll animation as more messages are sent, and several more."
                }
              ]
            }
          ]
        },
