            }
          ]
        },
        {
          "title": "Saiyle",
          "subtitle": "Apr 2019 - Sep 2020",
          "subComponenets": [
            {
              "description": [
                {
                  "type": "textComponent",
                  "text": "Associated with UCLA"
                },
                {
                  "type": "textComponent",
                  "text": "'Saiyle' is a mobile app that acts as a delivery assistant - the app allows users to acquire various items in an efficient and cost-friendly manner and also perform deliveries for other users on the app. The project is affiliated with Creative Labs, UCLA.\n\nI work as a front-end React-Native developer and back-end Node.js developer for the app."
                }
              ]
            }
          ]
        },
        {
          "title": "Quickey",
          "subtitle": "Sep 2019 - Dec 2019",
          "subComponenets": [
            {
              "description": [
                {
                  "type": "textComponent",
                  "text": "Associated with UCLA"
                },
                {
                  "type": "textComponent",
                  "text": "Quickey is a chrome extension built using React that allows a user to add custom keyboard shortcuts to manage tabs in a browsing window. The extension also offers other unique features such as tab-decluttering, custom workspaces, etc to ameliorate the browsing experience."
                }
              ]
            }
          ]
        },
        {
          "title": "Servz",
          "subtitle": "Jul 2018 - Sep 2018",
          "subComponenets": [
            {
              "description": [
                {
                  "type": "textComponent",
                  "text": "Servz is a React-Native and Node.js based mobile app that aims to provide a range of features to enhance the interactions between consumers and service-providers, including attendance management and payment-tracking.\n\nA minimum viable prototype (MVP) of the front-end and back-end has been completed, and is currently under evaluation for commercial deployment."
                }
              ]
            }
          ]
        },
