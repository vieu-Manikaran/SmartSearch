          "subComponents": [
            {
              "description": {
                "type": "textComponent",
                "text": "I am leading the development of an Engineering Development Tool under Anthony Ricke's and JD Allen’s Guidance for Medtronic’s Robotic Surgical Technologies team, where we are building real-time data acquisition and 3D visualization features for electromagnetic sensor data used in lung navigation procedures. I oversee integration of multi-node EM sensor streams with a CT-based 3D lung model to enable calibration, registration, and catheter tracking in the LUNA system. I am also designing modular React.js interfaces for synchronized data streaming, visualization, and diagnostic logging to achieve sub-100ms latency and support efficient performance analysis for robotic control teams."
              }
            }
          ]
        }
