      "projects": [
        {
          "title": "CORSMAL",
          "subtitle": "Feb 2019 - Present",
          "subComponenets": [
            {
              "description": [
                {
                  "type": "textComponent",
                  "text": "CORSMAL is exploring the fusion of multiple sensing modalities (touch, sound, and first and third person vision) to accurately and robustly estimate the physical properties of objects in noisy and potentially ambiguous environments.\n\nWe aim to develop a framework for recognition and manipulation of objects via cooperation with humans by mimicking human capability of learning and adapting across a set of different manipulators, tasks, sensing configurations and environments.\n\nOur focus is to define learning architectures for multimodal sensory data and for aggregated data from different environments. The goal is to continually improve the adaptability and robustness of the learned models, and to generalise capabilities across tasks and sites."
                }
              ]
            }
          ]
        },
        {
          "title": "EventVideo",
          "subtitle": "Sep 2013 - Present",
          "subComponenets": [
            {
              "description": [
                {
                  "type": "textComponent",
                  "text": "The TEC2011-25995 EventVideo project, focused on segmentation, detection and tracking in video sequences for complex environments, has covered its objectives, yielding 16 articles in international journals, 2 book chapters and 11 articles in international conferences, as well as several evaluation datasets of utility for the scientific community."
                }
              ]
            }
          ]
        },
        {
          "title": "COPCAMS",
          "subtitle": "Dec 2015 - Sep 2016",
