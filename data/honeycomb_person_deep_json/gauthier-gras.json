      "projects": [
        {
          "title": "Microscopic Image-Guided Endoluminal Surgery (Micro-IGES) Robot",
          "subtitle": "Mar 2015 - Present",
          "subComponenets": [
            {
              "description": [
                {
                  "type": "textComponent",
                  "text": "- Worked as part of an 8-person team to develop a novel minimally invasive surgical robot.\n- Coded the underlying robotics library used, multiple device and user interfaces, and played a key role in the diagnosis and debugging of the kinematic behaviour.\n- Technology resulting from this and related work was used to form Precision Robotics, a spin-out company."
                }
              ]
            }
          ]
        },
        {
          "title": "Augmented Reality for Intra-Operative Imaging",
          "subtitle": "Sep 2014 - Present",
          "subComponenets": [
            {
              "description": [
                {
                  "type": "textComponent",
                  "text": "- Developed a real-time augmented reality display using OpenGL/OpenCL interoperability that preserves salient features.\n- Visual force feedback was developed using force sensing in conjunction with finite element modelling to enhance depth perception."
                }
              ]
            }
          ]
        },
        {
          "title": "Adaptive Motion Scaling",
          "subtitle": "Jun 2016 - Oct 2018",
          "subComponenets": [
            {
              "description": [
                {
                  "type": "textComponent",
                  "text": "- Developed a novel method for reducing the need for clutching, allowing for more intuitive control of highly dexterous systems.\n- Used information fusion from multiple sources such as eye and tool tracking to form a context-aware interface.\n- Developed a Bayesian optimization approach using Gaussian Processes to provide optimal user-specific robot behaviour."
                }
              ]
            }
          ]
        },
        {
          "title": "Robotic-Assisted Physiotherapy",
          "subtitle": "Jan 2013 - Oct 2013",
          "subComponenets": [
            {
              "description": [
                {
                  "type": "textComponent",
                  "text": "- Developed a learning from demonstration framework for robotic physiotherapy, allowing patients to train with a robot as though they were with a therapist. \n- Designed a multi-signal hierarchical dynamic time warping algorithm used in conjunction with Gaussian mixture models to transfer knowledge from the therapist to the robot."
                }
              ]
            }
          ]
