          "title": "Geometric Analysis of Foot Print and Foot Shape",
          "subtitle": "Oct 2014 - Oct 2014",
          "subComponenets": [
            {
              "description": [
                {
                  "type": "textComponent",
                  "text": "Associated with University of Oxford"
